#!/usr/bin/env bash
# 經 codex CLI 用 ChatGPT 訂閱身份叫 gpt-image-2 生圖（唔使 API key）
# 來源：oakplank/claude-gpt-image-bridge（已審閱），加咗 model_reasoning_effort=low 加速
# 用法: gpt-image-2 "<prompt>" <output.png> [--size WxH]

set -euo pipefail

if [[ $# -lt 2 ]]; then
  echo "usage: gpt-image-2 \"<prompt>\" <output.png> [--size WxH]" >&2
  exit 2
fi

prompt="$1"
out="$2"
shift 2

size=""
ref=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --size) size="$2"; shift 2 ;;
    --ref) ref="$2"; shift 2 ;;
    *) echo "gpt-image-2: unknown arg: $1" >&2; exit 2 ;;
  esac
done

if ! command -v codex >/dev/null 2>&1; then
  echo "gpt-image-2: codex CLI not found. brew install codex && codex login" >&2
  exit 127
fi

out_dir="$(cd "$(dirname "$out")" 2>/dev/null && pwd)" || {
  echo "gpt-image-2: output dir does not exist: $(dirname "$out")" >&2
  exit 2
}
out="$out_dir/$(basename "$out")"

size_line=""
if [[ -n "$size" ]]; then
  size_line="
SIZE: ${size}"
fi

# codex 喺 workspace-write sandbox 入面行，只可以寫自己工作目錄，
# 所以俾佢一個私有 temp 目錄，最後由 wrapper 負責 copy 去目標路徑
workdir="$(mktemp -d "${TMPDIR:-/tmp}/gpt-image-2.XXXXXX")"
log="${workdir}.log"

ref_line=""
ref_args=()
if [[ -n "$ref" ]]; then
  if [[ ! -f "$ref" ]]; then
    echo "gpt-image-2: ref image not found: $ref" >&2
    exit 2
  fi
  ref_args=(-i "$ref")
  ref_line="
STYLE REFERENCE: An image is attached. Match its exact visual style, color palette, rendering technique and level of detail."
fi

full_prompt="Use your image_generation tool (gpt-image-2) to create an image.

PROMPT: ${prompt}${size_line}${ref_line}

Requirements:
- You MUST call the image_generation tool.
- Do NOT write a Python script, shell out to curl, or fabricate a PNG any other way.
- After the tool produces the image, save the PNG as out.png in your current working directory. Use the relative path out.png, not an absolute path.
- Reply with only the file name of the saved PNG, nothing else."

# macOS bash 3.2：空 array 配 set -u 會報 unbound variable，要用 ${arr[@]+...} 寫法
if ! codex exec --skip-git-repo-check -s workspace-write \
    -c model_reasoning_effort=low \
    ${ref_args[@]+"${ref_args[@]}"} \
    -C "$workdir" "$full_prompt" </dev/null >"$log" 2>&1; then
  echo "gpt-image-2: codex exec failed. Last 30 lines of log:" >&2
  tail -n 30 "$log" >&2
  echo "(full log: $log)" >&2
  exit 1
fi

img="$workdir/out.png"
if [[ ! -f "$img" ]]; then
  img="$(ls -t "$workdir"/*.png 2>/dev/null | head -n 1 || true)"
fi

if [[ -z "$img" || ! -f "$img" ]]; then
  echo "gpt-image-2: codex finished but produced no PNG in $workdir. Last 30 lines of log:" >&2
  tail -n 30 "$log" >&2
  exit 1
fi

cp "$img" "$out"
rm -rf "$workdir" "$log" 2>/dev/null || true
echo "$out"
